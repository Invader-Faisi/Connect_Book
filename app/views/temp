<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

<div class="container mt-4">
    <h2>Events</h2>
    <button type="button" class="btn btn-primary mb-4" data-bs-toggle="modal" data-bs-target="#addEventModal">
        Add New Event
    </button>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Place</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="eventsTableBody">
            <!-- Dynamic data will be appended here -->
        </tbody>
    </table>
</div>

<!-- Add/Edit Event Modal -->
<div class="modal fade" id="addEventModal" tabindex="-1" aria-labelledby="addEventModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEventModalLabel">Add New Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addEventForm">
                    <input type="hidden" id="eventId" name="id">
                    <div class="mb-3">
                        <label for="eventName" class="form-label">Event Name</label>
                        <input type="text" class="form-control" id="eventName" name="event" required>
                    </div>
                    <div class="mb-3">
                        <label for="eventDate" class="form-label">Date</label>
                        <input type="date" class="form-control" id="eventDate" name="date" required>
                    </div>
                    <div class="mb-3">
                        <label for="eventPlace" class="form-label">Place</label>
                        <input type="text" class="form-control" id="eventPlace" name="place" required>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary" id="submitBtn">Save Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Fetch and populate event data on page load
    $.ajax({
        url: URL + 'event/getEvents',
        type: 'POST',
        dataType: 'JSON',
        success: function(response) {
            if (response.success) {
                // Clear existing table data
                $('#eventsTableBody').empty();

                // Iterate over the events data and populate the table
                response.data.forEach(function(event) {
                    const row = `
                        <tr>
                            <td>${event.event}</td>
                            <td>${event.date}</td>
                            <td>${event.place}</td>
                            <td>
                                <button class="btn btn-primary btn-sm edit-btn" data-id="${event.id}"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-danger btn-sm delete-btn" data-id="${event.id}"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    `;
                    $('#eventsTableBody').append(row);
                });

                // Attach click handlers for the newly added buttons
                $('.edit-btn').click(function() {
                    let eventId = $(this).data('id');
                    $('#submitBtn').val('Update');
                    editEvent(eventId);
                });

                $('.delete-btn').click(function() {
                    let eventId = $(this).data('id');
                    if (confirm('Are you sure you want to delete this event?')) {
                        alert('Deleted event with ID: ' + eventId);
                        // Add your delete functionality here
                    }
                });
            } else {
                toastr.error('Failed to load events.');
            }
        },
        error: function(xhr, status, error) {
            toastr.error('An error occurred while loading the events. Please try again.');
        }
    });

    // Function to open the edit event modal and populate it with existing data
    function editEvent(eventId) {
        // Example AJAX request to get event data by ID (replace with your actual endpoint)
        $.ajax({
            url: URL + 'event/getEventById',
            type: 'POST',
            data: { id: eventId },
            dataType: 'JSON',
            success: function(response) {
                if (response.success) {
                    // Populate the form with existing event data
                    $('#eventId').val(response.data.id);
                    $('#eventName').val(response.data.event);
                    $('#eventDate').val(response.data.date);
                    $('#eventPlace').val(response.data.place);

                    // Open the modal
                    $('#addEventModal').modal('show');
                } else {
                    toastr.error('Failed to load event data.');
                }
            },
            error: function(xhr, status, error) {
                toastr.error('An error occurred while loading the event data. Please try again.');
            }
        });
    }

    // Form submission handler for adding/updating events
    $('#addEventForm').on('submit', function(e) {
        e.preventDefault();

        // Get the form data
        var formData = $(this).serialize();

        // Determine the action URL based on the button value (Add or Update)
        var actionUrl = $('#submitBtn').val() === 'Update' ? URL + 'event/updateEvent' : URL + 'event/addEvent';

        // Example AJAX request to submit the form data (replace with your actual endpoint)
        $.ajax({
            url: actionUrl,
            type: 'POST',
            data: formData,
            success: function(response) {
                if (response.success) {
                    toastr.success('Event saved successfully!');
                    // Close the modal
                    $('#addEventModal').modal('hide');
                    // Refresh the table or make another AJAX call to get updated data
                    location.reload();
                } else {
                    toastr.error('Failed to save event.');
                }
            },
            error: function(xhr, status, error) {
                toastr.error('An error occurred while saving the event. Please try again.');
            }
        });
    });

    // Button click handler to reset the form for adding new event
    $('button[data-bs-target="#addEventModal"]').click(function() {
        $('#submitBtn').val('Save Event');
        $('#addEventModalLabel').text('Add New Event');
        $('#addEventForm')[0].reset();
    });
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
